APP_NAME=ProjectMind API
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Supabase (backend only for service role)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Recomendado para backend administrativo (NO usar en frontend)
SUPABASE_SECRET_KEY=
# Compatibilidad legacy, úsala solo si tu proyecto todavía usa service_role
SUPABASE_SERVICE_ROLE_KEY=

# IA principal: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# IA local alterna: LM Studio (servidor compatible con OpenAI)
AI_PROVIDER=openai
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=

# Consola CRUD de verificación (SOLO desarrollo)
# Genera un valor largo y aleatorio, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRUD_CONSOLE_ENABLED=false
CRUD_CONSOLE_TOKEN=
