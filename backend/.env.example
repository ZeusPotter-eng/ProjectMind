APP_NAME=ProjectMind API
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=
# Recomendado por Supabase para clientes públicos/autenticados.
SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad legacy (opcional si ya usas publishable key).
SUPABASE_ANON_KEY=

# SOLO BACKEND. No copies estas llaves al frontend ni al repositorio.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA principal: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# IA local alterna: LM Studio (servidor compatible con OpenAI)
AI_PROVIDER=openai
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=

# Consola CRUD de verificación (SOLO desarrollo)
# Requiere SUPABASE_SECRET_KEY o SUPABASE_SERVICE_ROLE_KEY.
CRUD_CONSOLE_ENABLED=false
CRUD_CONSOLE_TOKEN=
